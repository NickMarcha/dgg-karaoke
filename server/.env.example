# The API's own settings. Locally this file is server/.env; on the server the deployment platform
# writes it from the stack's environment.

# Applies only when the database volume is first created. Changing it later does not change the
# password of an existing database.
POSTGRES_PASSWORD=local_only

# The frontend's origins, not the API's, comma-separated. CORS and the remote-mic socket check
# compare against them.
APP_ORIGIN=http://localhost:3000

# destiny.gg sign-in. compose.test.yaml replaces all of these with the local stand-in in dev/dgg-oauth,
# so they matter only for the deployed stack and for `npm run dev`.
DGG_CLIENT_ID=dev-client
DGG_CLIENT_SECRET=dev-secret
# The site's /auth/callback, exactly as registered with destiny.gg.
DGG_REDIRECT_URI=http://localhost:3000/auth/callback
# Left empty, both are https://www.destiny.gg. Locally they point at the stand-in.
DGG_ORIGIN=http://localhost:8789
DGG_AUTHORIZE_ORIGIN=http://localhost:8789
# The remote-mic and online relays serve only signed-in people, who sing under their destiny.gg
# names. false lets anyone connect and type a nickname. Defaults to true.
SIGN_IN_REQUIRED=true
# Always admins, comma-separated destiny.gg usernames.
ADMIN_DGG_USERNAMES=

# A Cloudflare Realtime TURN key (dashboard: Realtime > TURN Server). With it, a phone that cannot
# reach its game directly relays through Cloudflare; without it, phones use STUN and then the API.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Only the deployed stack runs the tunnel; compose.test.yaml parks it, but compose still needs a value.
CLOUDFLARE_TUNNEL_TOKEN=unused-locally

# For `npm run dev` outside Docker, against the database from `npm run stack:test`.
DATABASE_URL=postgresql://dgg_karaoke:local_only@127.0.0.1:54330/dgg_karaoke
