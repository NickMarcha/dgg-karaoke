EXTEND_ESLINT=true

# Our own PostHog project. Empty turns analytics off; nothing here may report to allkaraoke's.
VITE_APP_POSTHOG_KEY=""
VITE_APP_POSTHOG_PROXY="https://eu.i.posthog.com"

# The API in server/: the remote-mic relay and the song importer's proxy. This is the local test
# stack (`npm run stack:test` in server/); netlify.toml sets the deployed one for production builds.
VITE_APP_API_URL="http://localhost:8788"

# Changing the config name to mts causes this https://github.com/vitejs/vite/issues/13267
VITE_CJS_IGNORE_WARNING=true
